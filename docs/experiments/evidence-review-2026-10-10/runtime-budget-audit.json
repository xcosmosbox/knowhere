  "policy": {
    "initial_limits": "initial_max_steps == 15 and initial_wall_clock_seconds == 180",
    "review_step_bound": "0 <= steps_used <= final_max_steps <= 15; at most 2 reviewer attempts and 1 corrective retrieval",
    "baseline_step_bound": "final_max_steps == 15; steps_used <= 16 because the unchanged baseline can consume its documented forced-finish call",
    "tightening_formula": "If a correction is initiated at charged step B, final_max_steps == min(15, B + 4). B includes the first reviewer attempt when one occurs; empty-evidence correction can occur with zero reviewer attempts.",
    "step_reconstruction": "Count unique explorer round_index values excluding corpus.pick and evidence_review, then add reviewer attempts. Multiple tool calls in a round do not create extra charged steps. Pick calls still consume wall time and tokens.",
    "other_gates": "This interpretation does not waive any other original runtime gate or change the trial semantic outcome.",
    "resume": "Resume only IDs absent from both completed trials and the durable started journal; preserve interrupted/unknown outcomes and all original false gate values. Never rerun a completed gate-failing trial.",
    "wall_clock_limit": "The observer records only initial_wall_clock_seconds. Frozen source identity and actual durations support this audit; elapsed duration alone does not prove server-side cancellation or a final wall-clock setting."
  },
